---
export interface MaterialsViewClassification {
  area: string;
  subarea: string;
  conteudo: string;
}

export interface MaterialsViewResource {
  nome: string;
  url: string;
}

export interface MaterialsViewItem {
  titulo: string;
  descricao?: string;
  tipo: string;
  classificacoes: MaterialsViewClassification[];
  arquivoLink: MaterialsViewResource;
}

interface Props {
  itens: MaterialsViewItem[];
}

const { itens } = Astro.props;

const areas = [
  ...new Set(
    itens.flatMap((material) =>
      material.classificacoes.map(({ area }) => area),
    ),
  ),
];
const subareas = [
  ...new Set(
    itens.flatMap((material) =>
      material.classificacoes.map(({ subarea }) => subarea),
    ),
  ),
];
const conteudos = [
  ...new Set(
    itens.flatMap((material) =>
      material.classificacoes.map(({ conteudo }) => conteudo),
    ),
  ),
];
const tipos = [...new Set(itens.map(({ tipo }) => tipo))];
---

<section
  class="materials-validation"
  aria-labelledby="materials-validation-title"
>
  <header class="materials-validation__header">
    <h2 id="materials-validation-title">Materiais</h2>
  </header>

  <div
    class="materials-validation__filters"
    role="search"
    aria-label="Filtros de materiais"
  >
    <label
      class:list={[
        'materials-validation__filter',
        'materials-validation__filter--search',
      ]}
    >
      <span>Busca</span>
      <input
        type="search"
        name="busca"
        autocomplete="off"
      />
    </label>

    <label class="materials-validation__filter">
      <span>Área</span>
      <select name="area">
        <option value="">Todas as áreas</option>
        {areas.map((area) => <option value={area}>{area}</option>)}
      </select>
    </label>

    <label class="materials-validation__filter">
      <span>Subárea</span>
      <select name="subarea">
        <option value="">Todas as subáreas</option>
        {
          subareas.map((subarea) => (
            <option value={subarea}>{subarea}</option>
          ))
        }
      </select>
    </label>

    <label class="materials-validation__filter">
      <span>Conteúdo</span>
      <select name="conteudo">
        <option value="">Todos os conteúdos</option>
        {
          conteudos.map((conteudo) => (
            <option value={conteudo}>{conteudo}</option>
          ))
        }
      </select>
    </label>

    <label class="materials-validation__filter">
      <span>Tipo</span>
      <select name="tipo">
        <option value="">Todos os tipos</option>
        {tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
      </select>
    </label>
  </div>

  <div
    class="materials-validation__list"
    aria-label="Acervo de materiais"
  >
    {
      itens.map((material) => (
        <article class="materials-validation__item">
          <header class="materials-validation__item-header">
            <h3>{material.titulo}</h3>

            <div class="materials-validation__type">
              <span>Tipo</span>
              <strong>{material.tipo}</strong>
            </div>
          </header>

          {material.descricao && (
            <p class="materials-validation__description">
              {material.descricao}
            </p>
          )}

          <section class="materials-validation__resource-section">
            <h4>Arquivo / link</h4>

            <a
              class="materials-validation__resource-link"
              href={material.arquivoLink.url}
            >
              {material.arquivoLink.nome}
            </a>
          </section>

          <section class="materials-validation__classification-section">
            <h4>
              {material.classificacoes.length > 1
                ? 'Classificações'
                : 'Classificação'}
            </h4>

            <ol class="materials-validation__classifications">
              {material.classificacoes.map((classificacao) => (
                <li class="materials-validation__classification">
                  <span>{classificacao.area}</span>
                  <span
                    class="materials-validation__classification-arrow"
                    aria-hidden="true"
                  >
                    →
                  </span>
                  <span>{classificacao.subarea}</span>
                  <span
                    class="materials-validation__classification-arrow"
                    aria-hidden="true"
                  >
                    →
                  </span>
                  <strong>{classificacao.conteudo}</strong>
                </li>
              ))}
            </ol>
          </section>
        </article>
      ))
    }
  </div>
</section>

<style>
  .materials-validation {
    margin: 24px 0 48px;
    text-align: left;
  }

  .materials-validation__header {
    margin-bottom: 18px;
  }

  .materials-validation__header h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: 30px;
    line-height: 1.15;
    font-weight: 850;
  }

  .materials-validation__filters {
    margin: 0 0 18px;
    padding: 18px 20px 20px;
    display: grid;
    grid-template-columns:
      minmax(230px, 1.65fr)
      repeat(4, minmax(0, 1fr));
    gap: 16px;
    border: 1.5px solid rgba(53, 87, 242, 0.20);
    border-radius: var(--radius-md);
    background:
      linear-gradient(
        135deg,
        rgba(53, 87, 242, 0.045),
        rgba(255, 255, 255, 0.98) 52%
      );
    box-shadow: var(--shadow-surface-light);
  }

  .materials-validation__filter {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .materials-validation__filter > span,
  .materials-validation__type span,
  .materials-validation__resource-section h4,
  .materials-validation__classification-section h4 {
    color: var(--color-text-muted);
    font-size: 10px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .materials-validation__filter > span {
    color: var(--color-text-secondary);
    font-size: 11px;
    letter-spacing: 0.045em;
  }

  .materials-validation__filter input,
  .materials-validation__filter select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 10px 13px;
    border: 1px solid rgba(53, 87, 242, 0.22);
    border-radius: var(--radius-control);
    outline: 0;
    background: var(--color-surface);
    color: #354052;
    font: inherit;
    font-size: 14px;
    font-weight: 650;
  }

  .materials-validation__filter input:focus-visible,
  .materials-validation__filter select:focus-visible {
    border-color: var(--color-primary-bright);
    box-shadow: 0 0 0 3px rgba(53, 87, 242, 0.13);
  }

  .materials-validation__list {
    overflow: hidden;
    border: 1.5px solid rgba(53, 87, 242, 0.24);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .materials-validation__item {
    position: relative;
    padding: 25px 26px 28px;
    border-bottom: 1px solid rgba(53, 87, 242, 0.12);
  }

  .materials-validation__item:last-child {
    border-bottom: 0;
  }

  .materials-validation__item::before {
    content: '';
    position: absolute;
    top: 25px;
    bottom: 28px;
    left: 0;
    width: 4px;
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    background: var(--color-accent);
  }

  .materials-validation__item-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, auto);
    align-items: start;
    gap: 28px;
  }

  .materials-validation__item h3 {
    min-width: 0;
    margin: 0;
    color: var(--color-heading);
    font-size: 20px;
    line-height: 1.32;
    font-weight: 850;
  }

  .materials-validation__type {
    min-width: 120px;
    padding-top: 2px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    text-align: right;
  }

  .materials-validation__type strong {
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.3;
    font-weight: 750;
  }

  .materials-validation__description {
    max-width: 80ch;
    margin: 18px 0 0;
    color: var(--color-text-secondary);
    font-size: 15px;
    line-height: 1.6;
    font-weight: 500;
  }

  .materials-validation__resource-section,
  .materials-validation__classification-section {
    min-width: 0;
    margin-top: 20px;
    display: grid;
    justify-items: start;
    gap: 8px;
  }

  .materials-validation__resource-section h4,
  .materials-validation__classification-section h4 {
    margin: 0;
  }

  .materials-validation__resource-link {
    max-width: 100%;
    min-height: 42px;
    padding: 9px 8px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-control);
    color: var(--color-primary);
    font-size: 14px;
    line-height: 1.35;
    font-weight: 800;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .materials-validation__resource-link:hover {
    background: rgba(53, 87, 242, 0.055);
  }

  .materials-validation__resource-link:focus-visible {
    outline: 2px solid var(--color-primary-bright);
    outline-offset: 2px;
  }

  .materials-validation__classifications {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .materials-validation__classification {
    min-width: 0;
    padding: 10px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 8px;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.5;
    font-weight: 600;
    overflow-wrap: normal;
    word-break: normal;
  }

  .materials-validation__classification:first-child {
    padding-top: 3px;
  }

  .materials-validation__classification +
    .materials-validation__classification {
    border-top: 1px dashed rgba(53, 87, 242, 0.18);
  }

  .materials-validation__classification strong {
    color: #3f4b60;
    font-weight: 850;
  }

  .materials-validation__classification-arrow {
    flex: none;
    color: #8a94a4;
    font-weight: 700;
  }

  @media (min-width: 768px) and (max-width: 1399px) {
    .materials-validation__filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .materials-validation__filter--search {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .materials-validation {
      margin-top: 20px;
    }

    .materials-validation__header h2 {
      font-size: 27px;
    }

    .materials-validation__filters {
      padding: 17px;
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .materials-validation__filter--search {
      grid-column: auto;
    }

    .materials-validation__item {
      padding: 22px 20px 24px;
    }

    .materials-validation__item::before {
      top: 22px;
      bottom: 24px;
    }

    .materials-validation__item-header {
      display: block;
    }

    .materials-validation__item h3 {
      width: 100%;
      max-width: 100%;
      font-size: 18px;
    }

    .materials-validation__type {
      min-width: 0;
      margin-top: 15px;
      align-items: flex-start;
      text-align: left;
    }

    .materials-validation__resource-section,
    .materials-validation__classification-section {
      margin-top: 18px;
    }

    .materials-validation__resource-link {
      min-height: 44px;
    }

    .materials-validation__classification {
      gap: 5px 7px;
      font-size: 13px;
    }
  }
</style>

