---
export interface WorksViewResource {
  nome: string;
  url: string;
}

export interface WorksViewItem {
  titulo: string;
  assunto: string;
  publicacao: string;
  entregaData: string;
  descricao?: string;
  documentoTrabalho: WorksViewResource;
  recursosAdicionais?: WorksViewResource[];
  atenuado?: boolean;
}

interface Props {
  itens: WorksViewItem[];
  assuntos: string[];
}

const {
  itens,
  assuntos,
} = Astro.props;
---

<section
  class="works-validation"
  aria-labelledby="works-validation-title"
>
  <header class="works-validation__header">
    <h2 id="works-validation-title">Trabalhos</h2>
  </header>

  <div
    class="works-validation__filters"
    role="search"
    aria-label="Filtros de trabalhos"
  >
    <label class="works-validation__filter">
      <span>Busca</span>
      <input
        type="search"
        name="busca"
        autocomplete="off"
      />
    </label>

    <label class="works-validation__filter">
      <span>Assunto</span>
      <select name="assunto">
        <option value="">Todos os assuntos</option>
        {
          assuntos.map((assunto) => (
            <option value={assunto}>{assunto}</option>
          ))
        }
      </select>
    </label>
  </div>

  <div
    class="works-validation__list"
    aria-label="Trabalhos publicados"
  >
    {
      itens.map((item) => (
        <article
          class:list={[
            'works-validation__item',
            {
              'works-validation__item--attenuated': item.atenuado,
            },
          ]}
        >
          <div class="works-validation__item-header">
            <h3>{item.titulo}</h3>

            <div class="works-validation__metadata">
              <div class="works-validation__metadata-item">
                <span>Assunto</span>
                <strong>{item.assunto}</strong>
              </div>

              <div class="works-validation__metadata-item">
                <span>Publicação</span>
                <strong>{item.publicacao}</strong>
              </div>

              <div
                class:list={[
                  'works-validation__metadata-item',
                  'works-validation__metadata-item--milestone',
                ]}
              >
                <span>Entrega</span>
                <strong>{item.entregaData}</strong>
              </div>
            </div>
          </div>

          <div class="works-validation__item-body">
            {item.descricao && (
              <p class="works-validation__description">
                {item.descricao}
              </p>
            )}

            <section class="works-validation__resource-section">
              <h4>Documento do trabalho</h4>

              <a
                class="works-validation__resource-link"
                href={item.documentoTrabalho.url}
              >
                {item.documentoTrabalho.nome}
              </a>
            </section>

            {
              item.recursosAdicionais
                && item.recursosAdicionais.length > 0
                && (
                  <section class="works-validation__resource-section">
                    <h4>Recursos adicionais</h4>

                    <div class="works-validation__resource-links">
                      {item.recursosAdicionais.map((recurso) => (
                        <a
                          class="works-validation__resource-link"
                          href={recurso.url}
                        >
                          {recurso.nome}
                        </a>
                      ))}
                    </div>
                  </section>
                )
            }
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .works-validation {
    margin: 24px 0 48px;
    text-align: left;
  }

  .works-validation__header {
    margin-bottom: 18px;
  }

  .works-validation__header h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: 30px;
    line-height: 1.15;
    font-weight: 850;
  }

  .works-validation__filters {
    margin: 0 0 18px;
    padding: 18px 20px 20px;
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    gap: 16px;
    border: 1.5px solid rgba(53, 87, 242, 0.20);
    border-radius: var(--radius-md);
    background:
      linear-gradient(
        135deg,
        rgba(53, 87, 242, 0.045),
        rgba(255, 255, 255, 0.98) 52%
      );
    box-shadow: var(--shadow-surface-light);
  }

  .works-validation__filter {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .works-validation__filter > span {
    color: var(--color-text-secondary);
    font-size: 11px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .works-validation__filter input,
  .works-validation__filter select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 10px 13px;
    border: 1px solid rgba(53, 87, 242, 0.22);
    border-radius: var(--radius-control);
    outline: 0;
    background: var(--color-surface);
    color: #354052;
    font: inherit;
    font-size: 14px;
    font-weight: 650;
  }

  .works-validation__filter input:focus-visible,
  .works-validation__filter select:focus-visible {
    border-color: var(--color-primary-bright);
    box-shadow: 0 0 0 3px rgba(53, 87, 242, 0.13);
  }

  .works-validation__list {
    overflow: hidden;
    border: 1.5px solid rgba(53, 87, 242, 0.24);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .works-validation__item {
    position: relative;
    padding: 25px 26px 26px;
    border-bottom: 1px solid rgba(53, 87, 242, 0.12);
  }

  .works-validation__item:last-child {
    border-bottom: 0;
  }

  .works-validation__item::before {
    content: '';
    position: absolute;
    top: 25px;
    bottom: 26px;
    left: 0;
    width: 4px;
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    background: var(--color-accent);
  }

  .works-validation__item-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 0.68fr);
    align-items: center;
    gap: 34px;
  }

  .works-validation__item h3 {
    min-width: 0;
    margin: 0;
    color: var(--color-heading);
    font-size: 19px;
    line-height: 1.3;
    font-weight: 850;
  }

  .works-validation__metadata {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 16px;
  }

  .works-validation__metadata-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    text-align: center;
  }

  .works-validation__metadata-item span,
  .works-validation__resource-section h4 {
    color: var(--color-text-muted);
    font-size: 10px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .works-validation__metadata-item strong {
    width: 100%;
    color: var(--color-text-secondary);
    font-size: 13px;
    line-height: 1.3;
    font-weight: 800;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .works-validation__metadata-item--milestone strong {
    color: var(--color-primary);
  }

  .works-validation__item-body {
    margin-top: 20px;
    display: grid;
    gap: 18px;
  }

  .works-validation__description {
    max-width: 80ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 15px;
    line-height: 1.6;
    font-weight: 500;
  }

  .works-validation__resource-section {
    min-width: 0;
    display: grid;
    justify-items: start;
    gap: 8px;
  }

  .works-validation__resource-section h4 {
    margin: 0;
  }

  .works-validation__resource-links {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
  }

  .works-validation__resource-link {
    max-width: 100%;
    min-height: 42px;
    padding: 9px 8px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-control);
    color: var(--color-primary);
    font-size: 14px;
    line-height: 1.25;
    font-weight: 800;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .works-validation__resource-link:hover {
    background: rgba(53, 87, 242, 0.055);
  }

  .works-validation__resource-link:focus-visible {
    outline: 2px solid var(--color-primary-bright);
    outline-offset: 2px;
  }

  .works-validation__item--attenuated {
    background:
      linear-gradient(
        135deg,
        rgba(105, 115, 132, 0.055),
        rgba(255, 255, 255, 0.88) 58%
      );
  }

  .works-validation__item--attenuated::before {
    background: #a7adb8;
  }

  .works-validation__item--attenuated h3,
  .works-validation__item--attenuated .works-validation__metadata-item strong,
  .works-validation__item--attenuated .works-validation__description {
    color: #697386;
  }

  .works-validation__item--attenuated .works-validation__resource-link {
    color: #5f6d88;
  }

  @media (max-width: 767px) {
    .works-validation__filters,
    .works-validation__item-header {
      grid-template-columns: minmax(0, 1fr);
    }

    .works-validation__metadata {
      grid-template-columns:
        minmax(0, 1.6fr)
        minmax(0, 1fr)
        minmax(0, 1fr);
    }

    .works-validation__metadata-item strong {
      overflow-wrap: normal;
      word-break: normal;
    }
  }
</style>
