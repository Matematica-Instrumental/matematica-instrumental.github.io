---
interface Props {
  segmento: string;
  anoSerie: string;
  turma: string;
  anoLetivo: number;
  descricao: string;
  arquivada?: boolean;
}

const {
  segmento,
  anoSerie,
  turma,
  anoLetivo,
  descricao,
  arquivada = false,
} = Astro.props;
---

<section class="turma-identity" aria-labelledby="turma-title">
  <span class="turma-identity__segment">{segmento}</span>

  <h1 id="turma-title">
    {anoSerie} — {turma}
  </h1>

  <p class="turma-identity__school-year">
    Ano letivo {anoLetivo}
  </p>

  {
    arquivada && (
      <p class="turma-identity__archived">
        Turma arquivada — ano letivo encerrado
      </p>
    )
  }

  <p class="turma-identity__description">
    {descricao}
  </p>
</section>

<style>
  .turma-identity {
    position: relative;
    height: 280px;
    padding: 28px 32px;
    overflow: hidden;
    border: 1.5px solid rgba(166, 129, 20, 0.45);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(
        135deg,
        rgba(255, 212, 82, 0.25),
        rgba(242, 195, 53, 0.08)
      );
    box-shadow: var(--shadow-surface);
    text-align: left;
  }

  .turma-identity::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 7px;
    background: var(--color-accent);
  }

  .turma-identity__segment {
    padding: 6px 11px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--radius-pill);
    background: rgba(242, 195, 53, 0.20);
    color: #705810;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .turma-identity h1 {
    margin: 18px 0 6px;
    color: var(--color-heading);
    font-size: 32px;
    line-height: 1.1;
  }

  .turma-identity__school-year {
    margin: 0;
    color: #665f4b;
    font-size: 15px;
    font-weight: 700;
  }

  .turma-identity__archived {
    margin: 10px 0 0;
    color: #665f4b;
    font-size: 14px;
    font-weight: 800;
  }

  .turma-identity__description {
    max-width: 670px;
    margin: 16px 0 0;
    color: var(--color-text-secondary);
    font-size: 16px;
    line-height: 1.45;
    font-weight: 500;
  }

  @media (min-width: 768px) and (max-width: 1399px) {
    .turma-identity {
      min-height: 245px;
      height: auto;
      padding: 26px 30px;
    }

    .turma-identity h1 {
      font-size: 30px;
    }

    .turma-identity__description {
      max-width: none;
    }
  }

  @media (max-width: 767px) {
    .turma-identity {
      min-height: 250px;
      height: auto;
      padding: 22px 22px 22px 24px;
      border-radius: var(--radius-lg);
    }

    .turma-identity__segment {
      padding: 5px 9px;
      font-size: 10px;
    }

    .turma-identity h1 {
      margin-top: 15px;
      font-size: 26px;
    }

    .turma-identity__school-year {
      font-size: 13px;
    }

    .turma-identity__description {
      max-width: none;
      margin-top: 13px;
      font-size: 14px;
      line-height: 1.4;
    }
  }
</style>
