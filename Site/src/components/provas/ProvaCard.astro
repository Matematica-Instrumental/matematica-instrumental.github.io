---
import type { ProvaViewItem } from '../../utils/provas';

interface Props {
  prova: ProvaViewItem;
}

const { prova } = Astro.props;
---

<article
  class="proof-card"
  id={prova.id}
  data-proof-card
  data-busca={prova.buscaNormalizada}
  data-segmento={prova.segmento}
  data-ano-serie={prova.anoSerie}
  data-instituicao={prova.instituicao}
  data-ano={String(prova.ano)}
  data-tipo={prova.tipo}
  data-fase={prova.fase ?? ''}
  data-assuntos={JSON.stringify(prova.assuntosNormalizados)}
  data-dificuldade={prova.dificuldade ?? ''}
>
  <div class="proof-card__labels">
    <span class="proof-card__type">{prova.tipo}</span>
    <span class="proof-card__segment">{prova.segmento}</span>
  </div>

  <div class="proof-card__heading">
    <h2>{prova.titulo}</h2>
    <p>{prova.instituicao}</p>
  </div>

  <dl class="proof-card__metadata">
    <div>
      <dt>Ano</dt>
      <dd>{prova.ano}</dd>
    </div>
    <div>
      <dt>Ano/Série</dt>
      <dd>{prova.anoSerie}</dd>
    </div>
    {
      prova.fase && (
        <div>
          <dt>Fase</dt>
          <dd>{prova.fase}</dd>
        </div>
      )
    }
    {
      prova.dificuldade && (
        <div>
          <dt>Dificuldade</dt>
          <dd>{prova.dificuldade}</dd>
        </div>
      )
    }
  </dl>

  <div class="proof-card__subjects">
    <span>Assuntos</span>
    <ul aria-label={`Assuntos de ${prova.titulo}`}>
      {prova.assuntos.map((assunto) => <li>{assunto}</li>)}
    </ul>
  </div>

  {prova.descricao && <p class="proof-card__description">{prova.descricao}</p>}

  <div class="proof-card__provenance">
    <p>
      <strong>Fonte oficial</strong>
      <a
        href={prova.fonte.href}
        target={prova.fonte.externo ? '_blank' : undefined}
        rel={prova.fonte.externo ? 'noopener noreferrer' : undefined}
      >
        {prova.fonte.nome}
      </a>
    </p>
    {prova.condicaoUso && <p>{prova.condicaoUso}</p>}
  </div>

  <div class="proof-card__actions">
    <a
      class="proof-card__action proof-card__action--primary"
      href={prova.prova.href}
      target={prova.prova.externo ? '_blank' : undefined}
      rel={prova.prova.externo ? 'noopener noreferrer' : undefined}
      aria-label={`Ver prova: ${prova.titulo}`}
    >
      Ver prova
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 17 17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </a>
    {
      prova.resolucao && (
        <a
          class="proof-card__action"
          href={prova.resolucao.href}
          target={prova.resolucao.externo ? '_blank' : undefined}
          rel={prova.resolucao.externo ? 'noopener noreferrer' : undefined}
          aria-label={`Ver resolução: ${prova.titulo}`}
        >
          Ver resolução
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      )
    }
  </div>
</article>

<style>
  .proof-card {
    min-width: 0;
    padding: 25px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-neutral);
    border-top: 4px solid var(--color-primary-bright);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface-light);
  }

  .proof-card__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .proof-card__type,
  .proof-card__segment {
    display: inline-flex;
    align-items: center;
    min-height: 27px;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .proof-card__type {
    background: #edf1ff;
    color: var(--color-primary);
  }

  .proof-card__segment {
    background: #fff7dc;
    color: #725b14;
  }

  .proof-card__heading {
    margin-top: 17px;
  }

  .proof-card__heading h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }

  .proof-card__heading p {
    margin: 7px 0 0;
    color: var(--color-text-secondary);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.45;
  }

  .proof-card__metadata {
    margin: 20px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--color-border-neutral);
  }

  .proof-card__metadata div {
    min-width: 0;
    padding: 13px 10px 13px 0;
  }

  .proof-card__metadata dt,
  .proof-card__subjects > span,
  .proof-card__provenance strong {
    color: var(--color-text-muted);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }

  .proof-card__metadata dd {
    margin: 5px 0 0;
    color: var(--color-heading);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  .proof-card__subjects {
    margin-top: 17px;
  }

  .proof-card__subjects ul {
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
  }

  .proof-card__subjects li {
    padding: 5px 9px;
    border: 1px solid #dce2ec;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-size: 11px;
    font-weight: 700;
  }

  .proof-card__description {
    margin: 16px 0 0;
    color: var(--color-text-secondary);
    font-size: 13px;
    line-height: 1.55;
  }

  .proof-card__provenance {
    margin-top: 18px;
    padding-top: 15px;
    border-top: 1px solid var(--color-border-neutral);
  }

  .proof-card__provenance p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .proof-card__provenance p + p {
    margin-top: 7px;
  }

  .proof-card__provenance strong {
    margin-right: 8px;
  }

  .proof-card__provenance a {
    color: var(--color-primary);
    font-weight: 750;
    text-underline-offset: 3px;
  }

  .proof-card__actions {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .proof-card__action {
    min-height: 42px;
    padding: 9px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-control);
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 850;
    text-decoration: none;
  }

  .proof-card__action--primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: var(--shadow-action);
  }

  .proof-card__action:hover {
    background: #f2f5ff;
  }

  .proof-card__action--primary:hover {
    background: var(--color-primary-bright);
  }

  .proof-card__action:focus-visible {
    outline: 3px solid rgba(53, 87, 242, 0.28);
    outline-offset: 2px;
  }

  .proof-card__action svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 767px) {
    .proof-card {
      padding: 21px 18px;
    }

    .proof-card__heading h2 {
      font-size: 19px;
    }

    .proof-card__metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .proof-card__metadata div:nth-child(odd) {
      padding-right: 12px;
    }

    .proof-card__actions {
      flex-direction: column;
    }

    .proof-card__action {
      width: 100%;
      min-height: 46px;
    }
  }
</style>
