---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import MainNavigation from '../components/global/MainNavigation.astro';
import Footer from '../components/global/Footer.astro';
import { applyAstroBaseUrl } from '../utils/turmaRoutes';

interface Props {
  title?: string;
  description?: string;
  persistentNavigation?: boolean;
}

const {
  title = 'Matemática Instrumental',
  description = 'Portal Matemática Instrumental — Professor Adriano Lima Teixeira',
  persistentNavigation = false,
} = Astro.props;

const faviconHref = applyAstroBaseUrl('/favicon.svg');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href={faviconHref} />

    <title>{title}</title>
  </head>

  <body>
    <Header />
    <MainNavigation persistent={persistentNavigation} />

    <slot />

    <Footer />
  </body>
</html>
