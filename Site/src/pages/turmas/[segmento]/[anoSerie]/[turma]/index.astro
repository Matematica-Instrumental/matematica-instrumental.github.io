---
import { getCollection } from 'astro:content';
import TurmaInicioPagina from '../../../../../components/turma/TurmaInicioPagina.astro';
import { assertCurrentContentIntegrity } from '../../../../../utils/contentIntegrityBuild';
import {
  getTurmaRouteParams,
  turmaEhCurso,
} from '../../../../../utils/turmaRoutes';

export async function getStaticPaths() {
  await assertCurrentContentIntegrity();
  const turmas = await getCollection('turmas', ({ data }) => !turmaEhCurso(data));

  return turmas.map((entry) => ({
    params: getTurmaRouteParams(entry.data),
    props: {
      turma: entry.data,
    },
  }));
}

const { turma } = Astro.props;
---

<TurmaInicioPagina turma={turma} />
