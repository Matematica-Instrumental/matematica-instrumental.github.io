---
export interface StudyViewResource {
  nome: string;
  url: string;
}

export interface StudyViewItem {
  titulo: string;
  objetivo: string;
  assunto: string;
  publicacao: string;
  dataObjetivo?: string;
  resumoOrientacao: string;
  recursos: StudyViewResource[];
  leiturasRelacionadas?: StudyViewResource[];
  atenuado?: boolean;
}

interface Props {
  itens: StudyViewItem[];
  assuntos: string[];
}

const {
  itens,
  assuntos,
} = Astro.props;
---

<section
  class="study-validation"
  aria-labelledby="study-validation-title"
>
  <header class="study-validation__header">
    <h2 id="study-validation-title">Para estudar</h2>
  </header>

  <div
    class="study-validation__filters"
    role="search"
    aria-label="Filtros de roteiros de estudo"
  >
    <label class="study-validation__filter">
      <span>Busca</span>
      <input
        type="search"
        name="busca"
        autocomplete="off"
      />
    </label>

    <label class="study-validation__filter">
      <span>Assunto</span>
      <select name="assunto">
        <option value="">Todos os assuntos</option>
        {
          assuntos.map((assunto) => (
            <option value={assunto}>{assunto}</option>
          ))
        }
      </select>
    </label>
  </div>

  <div
    class="study-validation__list"
    aria-label="Roteiros de estudo publicados"
  >
    {
      itens.map((item) => (
        <article
          class:list={[
            'study-validation__item',
            {
              'study-validation__item--attenuated': item.atenuado,
            },
          ]}
        >
          <div class="study-validation__item-header">
            <div class="study-validation__item-main">
              <h3>{item.titulo}</h3>
            </div>

            <div
              class:list={[
                'study-validation__metadata',
                {
                  'study-validation__metadata--three': item.dataObjetivo,
                },
              ]}
            >
              <div class="study-validation__metadata-item">
                <span>Assunto</span>
                <strong>{item.assunto}</strong>
              </div>

              <div class="study-validation__metadata-item">
                <span>Publicação</span>
                <strong>{item.publicacao}</strong>
              </div>

              {
                item.dataObjetivo && (
                  <div class="study-validation__metadata-item">
                    <span>Data</span>
                    <strong>{item.dataObjetivo}</strong>
                  </div>
                )
              }
            </div>
          </div>

          <div class="study-validation__item-body">
            <div class="study-validation__objective">
              <span>Objetivo</span>
              <strong>{item.objetivo}</strong>
            </div>

            <p class="study-validation__orientation">
              {item.resumoOrientacao}
            </p>

            <section class="study-validation__resource-section">
              <h4>Recursos</h4>

              <div class="study-validation__resource-links">
                {item.recursos.map((recurso) => (
                  <a
                    class="study-validation__resource-link"
                    href={recurso.url}
                  >
                    {recurso.nome}
                  </a>
                ))}
              </div>
            </section>

            {
              item.leiturasRelacionadas
                && item.leiturasRelacionadas.length > 0
                && (
                  <section class="study-validation__resource-section">
                    <h4>Leituras relacionadas</h4>

                    <div class="study-validation__resource-links">
                      {item.leiturasRelacionadas.map((leitura) => (
                        <a
                          class="study-validation__resource-link"
                          href={leitura.url}
                        >
                          {leitura.nome}
                        </a>
                      ))}
                    </div>
                  </section>
                )
            }
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .study-validation {
    margin: 24px 0 48px;
    text-align: left;
  }

  .study-validation__header {
    margin-bottom: 18px;
  }

  .study-validation__header h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: 30px;
    line-height: 1.15;
    font-weight: 850;
  }

  .study-validation__filters {
    margin: 0 0 18px;
    padding: 18px 20px 20px;
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    gap: 16px;
    border: 1.5px solid rgba(53, 87, 242, 0.20);
    border-radius: var(--radius-md);
    background:
      linear-gradient(
        135deg,
        rgba(53, 87, 242, 0.045),
        rgba(255, 255, 255, 0.98) 52%
      );
    box-shadow: var(--shadow-surface-light);
  }

  .study-validation__filter {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .study-validation__filter > span {
    color: var(--color-text-secondary);
    font-size: 11px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .study-validation__filter input,
  .study-validation__filter select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 10px 13px;
    border: 1px solid rgba(53, 87, 242, 0.22);
    border-radius: var(--radius-control);
    outline: 0;
    background: var(--color-surface);
    color: #354052;
    font: inherit;
    font-size: 14px;
    font-weight: 650;
  }

  .study-validation__filter input:focus-visible,
  .study-validation__filter select:focus-visible {
    border-color: var(--color-primary-bright);
    box-shadow: 0 0 0 3px rgba(53, 87, 242, 0.13);
  }

  .study-validation__list {
    overflow: hidden;
    border: 1.5px solid rgba(53, 87, 242, 0.24);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .study-validation__item {
    position: relative;
    padding: 25px 26px 26px;
    border-bottom: 1px solid rgba(53, 87, 242, 0.12);
  }

  .study-validation__item:last-child {
    border-bottom: 0;
  }

  .study-validation__item::before {
    content: '';
    position: absolute;
    top: 25px;
    bottom: 26px;
    left: 0;
    width: 4px;
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    background: var(--color-accent);
  }

  .study-validation__item-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(440px, 0.72fr);
    align-items: center;
    gap: 30px;
  }

  .study-validation__item-main {
    min-width: 0;
  }

  .study-validation__objective {
    max-width: 80ch;
    display: grid;
    gap: 6px;
  }

  .study-validation__objective span,
  .study-validation__metadata-item span,
  .study-validation__resource-section h4 {
    color: var(--color-text-muted);
    font-size: 10px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .study-validation__objective strong {
    color: #3f4b60;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 900;
  }

  .study-validation__item h3 {
    min-width: 0;
    margin: 0;
    color: var(--color-heading);
    font-size: 19px;
    line-height: 1.3;
    font-weight: 850;
  }

  .study-validation__metadata {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 16px;
  }

  .study-validation__metadata-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    text-align: center;
  }

  .study-validation__metadata-item strong {
    width: 100%;
    color: var(--color-text-secondary);
    font-size: 13px;
    line-height: 1.3;
    font-weight: 800;
    text-align: center;
  }

  .study-validation__item-body {
    margin-top: 20px;
    display: grid;
    gap: 18px;
  }

  .study-validation__orientation {
    max-width: 80ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 15px;
    line-height: 1.6;
    font-weight: 500;
  }

  .study-validation__resource-section {
    min-width: 0;
    display: grid;
    gap: 8px;
  }

  .study-validation__resource-section h4 {
    margin: 0;
  }

  .study-validation__resource-links {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
  }

  .study-validation__resource-link {
    max-width: 100%;
    min-height: 42px;
    padding: 9px 8px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-control);
    color: var(--color-primary);
    font-size: 14px;
    line-height: 1.25;
    font-weight: 800;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .study-validation__resource-link:hover {
    background: rgba(53, 87, 242, 0.055);
  }

  .study-validation__resource-link:focus-visible {
    outline: 2px solid var(--color-primary-bright);
    outline-offset: 2px;
  }

  .study-validation__item--attenuated {
    background:
      linear-gradient(
        135deg,
        rgba(105, 115, 132, 0.055),
        rgba(255, 255, 255, 0.88) 58%
      );
  }

  .study-validation__item--attenuated::before {
    background: #a7adb8;
  }

  .study-validation__item--attenuated h3,
  .study-validation__item--attenuated .study-validation__objective strong,
  .study-validation__item--attenuated .study-validation__metadata-item strong,
  .study-validation__item--attenuated .study-validation__orientation {
    color: #697386;
  }

  .study-validation__item--attenuated .study-validation__objective span {
    color: #848c99;
  }

  .study-validation__item--attenuated .study-validation__resource-link {
    color: #5f6d88;
  }

  @media (max-width: 767px) {
    .study-validation__item-header {
      display: block;
      grid-template-columns: none;
    }

    .study-validation__item-main,
    .study-validation__item h3 {
      width: 100%;
      min-width: 0;
      max-width: 100%;
      box-sizing: border-box;
      text-align: left;
    }

    .study-validation__metadata {
      width: 100%;
      min-width: 0;
      margin-top: 18px;
      box-sizing: border-box;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .study-validation__metadata-item {
      width: 100%;
      min-width: 0;
      text-align: center;
    }

    .study-validation__metadata-item span,
    .study-validation__metadata-item strong {
      min-width: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    .study-validation__metadata--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .study-validation__objective {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
  }
</style>
