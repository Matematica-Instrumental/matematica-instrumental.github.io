---
import { applyAstroBaseUrl } from '../../utils/turmaRoutes';

interface Props {
  segmento: string;
  anoSerie: string;
  turma: string;
}

const {
  segmento,
  anoSerie,
  turma,
} = Astro.props;

const inicioHref = applyAstroBaseUrl('/');
const turmasHref = applyAstroBaseUrl('/turmas/');
---

<nav class="breadcrumb" aria-label="Navegação hierárquica">
  <a class="breadcrumb__item" href={inicioHref}>Início</a>
  <span class="breadcrumb__separator" aria-hidden="true">›</span>

  <a class="breadcrumb__item" href={turmasHref}>Turmas</a>
  <span class="breadcrumb__separator" aria-hidden="true">›</span>

  <span class="breadcrumb__item">{segmento}</span>
  <span class="breadcrumb__separator" aria-hidden="true">›</span>

  <span class="breadcrumb__item">{anoSerie}</span>
  <span class="breadcrumb__separator" aria-hidden="true">›</span>

  <span class="breadcrumb__current" aria-current="page">{turma}</span>
</nav>

<style>
  .breadcrumb {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #556070;
    font-size: 15px;
    font-weight: 600;
  }

  .breadcrumb__item {
    color: var(--color-primary-bright);
    text-decoration: none;
    white-space: nowrap;
  }

  .breadcrumb__current {
    color: var(--color-heading);
    font-weight: 700;
    white-space: nowrap;
  }

  .breadcrumb__separator {
    color: #9aa3ad;
    font-size: 19px;
    font-weight: 400;
    line-height: 1;
  }

  @media (min-width: 768px) and (max-width: 1399px) {
    .breadcrumb {
      min-height: 58px;
      height: auto;
      padding: 14px 0;
      flex-wrap: wrap;
      gap: 7px 9px;
      font-size: 13px;
    }

    .breadcrumb__separator {
      font-size: 17px;
    }
  }

  @media (max-width: 767px) {
    .breadcrumb {
      min-height: 64px;
      height: auto;
      padding: 12px 0;
      flex-wrap: wrap;
      gap: 5px 7px;
      font-size: 11px;
      line-height: 1.25;
    }

    .breadcrumb__separator {
      font-size: 14px;
    }
  }
</style>
