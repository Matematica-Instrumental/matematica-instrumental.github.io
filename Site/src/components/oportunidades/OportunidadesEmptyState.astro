---
interface Props {
  tipo: 'vazio' | 'sem-resultados';
  hidden?: boolean;
}

const { tipo, hidden = false } = Astro.props;
const semResultados = tipo === 'sem-resultados';
---

<section
  class:list={['empty-state', { 'empty-state--results': semResultados }]}
  role="status"
  hidden={hidden}
  data-empty-state={tipo === 'vazio' ? '' : undefined}
  data-no-results-state={semResultados ? '' : undefined}
>
  {
    semResultados ? (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16 16 4 4M8 11h6"></path>
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="4" y="5" width="16" height="15" rx="2"></rect>
        <path d="M8 3v4M16 3v4M4 10h16"></path>
      </svg>
    )
  }
  <h2>
    {
      semResultados
        ? 'Nenhuma oportunidade corresponde aos filtros selecionados.'
        : 'Nenhuma oportunidade ou data disponível no momento.'
    }
  </h2>
  {
    semResultados && (
      <button type="button" data-clear-filters>Limpar filtros</button>
    )
  }
</section>

<style>
  .empty-state {
    margin-top: 24px;
    min-height: 190px;
    padding: 38px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 13px;
    border: 1px solid var(--color-border-neutral);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-text-muted);
    text-align: center;
    box-shadow: var(--shadow-surface-light);
  }

  .empty-state--results {
    margin-top: 20px;
  }

  svg {
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--color-primary-bright);
  }

  h2 {
    margin: 0;
    max-width: 620px;
    color: var(--color-heading);
    font-size: 18px;
    line-height: 1.4;
  }

  button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-primary);
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  button:focus-visible {
    outline: 3px solid rgba(53, 87, 242, 0.28);
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    .empty-state {
      min-height: 160px;
      padding: 30px 18px;
    }
  }
</style>
