---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/home/HomeContent.astro';
import { getNovidadesDaHome } from '../utils/novidades';
import { getAcessosTurmasHome } from '../utils/turmaContent';
import { selecionarDestaquesHomeMatematicaAlem } from '../utils/matematicaAlem';
import { resolverImagemMatematicaAlem } from '../utils/matematicaAlemAssets';
import { carregarMatematicaAlem } from '../utils/matematicaAlemLoader';

const [novidades, turmas, publicacoes] = await Promise.all([
  getNovidadesDaHome(),
  getCollection('turmas'),
  carregarMatematicaAlem(),
]);
const grupos = getAcessosTurmasHome(turmas.map(({ data }) => data));
const destaques = selecionarDestaquesHomeMatematicaAlem(
  publicacoes, 3, resolverImagemMatematicaAlem,
);
---

<BaseLayout title="Matemática Instrumental">
  <main class="home-page">
    <HomeContent novidades={novidades} grupos={grupos} destaques={destaques} />
  </main>
</BaseLayout>

<style>
  .home-page {
    width: min(var(--content-width-desktop), calc(100% - 36px));
    margin: 0 auto;
    padding: 24px 0 0;
  }

  @media (min-width: 768px) and (max-width: 1399px) {
    .home-page { width: min(var(--content-width-tablet), calc(100% - 36px)); padding-top: 20px; }
  }

  @media (max-width: 767px) {
    .home-page { width: min(var(--content-width-mobile), calc(100% - 36px)); padding-top: 16px; }
  }
</style>
