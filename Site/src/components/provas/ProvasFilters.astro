---
import type { ProvasFilterOptions } from '../../utils/provas';

interface Props {
  opcoes: ProvasFilterOptions;
}

const { opcoes } = Astro.props;
---

<section
  class="proofs-filters"
  aria-labelledby="proofs-filters-title"
  data-proofs-filters
>
  <div class="proofs-filters__heading">
    <div>
      <p class="proofs-filters__eyebrow">
        Acervo de provas
      </p>
      <h2 id="proofs-filters-title">Filtrar provas</h2>
    </div>
    <button
      class="proofs-filters__clear"
      type="button"
      data-clear-filters
      hidden
    >
      Limpar filtros
    </button>
  </div>

  <div class="proofs-filters__grid" role="search">
    <label class="proofs-filter proofs-filter--search">
      <span>Busca</span>
      <input
        type="search"
        name="busca"
        autocomplete="off"
        placeholder="Título, instituição, fase ou assunto"
        data-filter-control
      />
    </label>

    <label class="proofs-filter">
      <span>Segmento</span>
      <select name="segmento" data-filter-control>
        <option value="">Todos os segmentos</option>
        {
          opcoes.segmentos.map((segmento) => (
            <option value={segmento}>{segmento}</option>
          ))
        }
      </select>
    </label>

    <label class="proofs-filter">
      <span>Ano/Série</span>
      <select name="anoSerie" data-filter-control>
        <option value="">Todas as séries</option>
        {
          opcoes.anosSeries.map(({ valor, segmento }) => (
            <option value={valor} data-segmento={segmento}>{valor}</option>
          ))
        }
      </select>
    </label>

    <label class="proofs-filter">
      <span>Instituição</span>
      <select name="instituicao" data-filter-control>
        <option value="">Todas as instituições</option>
        {
          opcoes.instituicoes.map((instituicao) => (
            <option value={instituicao}>{instituicao}</option>
          ))
        }
      </select>
    </label>

    <label class="proofs-filter">
      <span>Ano</span>
      <select name="ano" data-filter-control>
        <option value="">Todos os anos</option>
        {opcoes.anos.map((ano) => <option value={ano}>{ano}</option>)}
      </select>
    </label>

    <label class="proofs-filter">
      <span>Tipo</span>
      <select name="tipo" data-filter-control>
        <option value="">Todos os tipos</option>
        {opcoes.tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
      </select>
    </label>

    <label class="proofs-filter">
      <span>Fase</span>
      <select name="fase" data-filter-control>
        <option value="">Todas as fases</option>
        {opcoes.fases.map((fase) => <option value={fase}>{fase}</option>)}
      </select>
    </label>

    <label class="proofs-filter">
      <span>Assunto</span>
      <select name="assunto" data-filter-control>
        <option value="">Todos os assuntos</option>
        {
          opcoes.assuntos.map((assunto) => (
            <option value={assunto}>{assunto}</option>
          ))
        }
      </select>
    </label>

    {
      opcoes.dificuldades.length > 0 && (
        <label class="proofs-filter">
          <span>Dificuldade</span>
          <select name="dificuldade" data-filter-control>
            <option value="">Todas as dificuldades</option>
            {
              opcoes.dificuldades.map((dificuldade) => (
                <option value={dificuldade}>{dificuldade}</option>
              ))
            }
          </select>
        </label>
      )
    }
  </div>
</section>

<style>
  .proofs-filters {
    margin-top: 24px;
    padding: 26px;
    border: 1px solid var(--color-border-neutral);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface);
  }

  .proofs-filters__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .proofs-filters__eyebrow {
    margin: 0 0 8px;
    color: var(--color-primary-bright);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .proofs-filters__heading h2 {
    margin: 0;
    color: var(--color-heading);
    font-size: 21px;
  }

  .proofs-filters__clear {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .proofs-filters__grid {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .proofs-filter {
    min-width: 0;
    display: grid;
    gap: 7px;
    color: var(--color-heading);
    font-size: 12px;
    font-weight: 850;
  }

  .proofs-filter--search {
    grid-column: span 2;
  }

  .proofs-filter input,
  .proofs-filter select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid #cfd5df;
    border-radius: var(--radius-control);
    background: #fff;
    color: var(--color-text);
    font: inherit;
    font-size: 13px;
    font-weight: 450;
  }

  .proofs-filter input::placeholder {
    color: #7b8390;
  }

  .proofs-filter input:focus-visible,
  .proofs-filter select:focus-visible,
  .proofs-filters__clear:focus-visible {
    outline: 3px solid rgba(53, 87, 242, 0.28);
    outline-offset: 2px;
  }

  @media (min-width: 768px) and (max-width: 1399px) {
    .proofs-filters__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .proofs-filters {
      margin-top: 18px;
      padding: 22px 18px;
      border-radius: var(--radius-lg);
    }

    .proofs-filters__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .proofs-filters__grid {
      margin-top: 17px;
      grid-template-columns: minmax(0, 1fr);
      gap: 13px;
    }

    .proofs-filter--search {
      grid-column: auto;
    }
  }
</style>
