---
import { applyAstroBaseUrl } from '../../utils/turmaRoutes';

const atalhos = [
  {
    titulo: 'Turmas',
    descricao: 'Acesse os conteúdos organizados por segmento, ano/série e turma.',
    caminho: '/turmas/',
    icone: 'users',
  },
  {
    titulo: 'Provas e Resoluções',
    descricao: 'Consulte provas de Matemática e resoluções, quando disponíveis.',
    caminho: '/provas-e-resolucoes/',
    icone: 'document',
  },
  {
    titulo: 'Oportunidades e Datas',
    descricao: 'Acompanhe oportunidades acadêmicas e datas importantes.',
    caminho: '/oportunidades-e-datas/',
    icone: 'calendar',
  },
  {
    titulo: 'Matemática além da sala',
    descricao: 'Explore curiosidades, história, aplicações, desafios e recursos de Matemática.',
    caminho: '/matematica-alem-da-sala/',
    icone: 'video',
  },
  {
    titulo: 'Falar com o Professor',
    descricao: 'Envie uma mensagem privada ao professor.',
    caminho: '/falar-com-o-professor/',
    icone: 'message',
  },
];
---

<section class="home-panel home-quick" id="acesso-rapido" aria-labelledby="quick-title">
  <h2 id="quick-title">Acesso rápido</h2>
  <div class="home-quick__grid">
    {atalhos.map((atalho) => (
      <a class="home-quick__card" href={applyAstroBaseUrl(atalho.caminho)}>
        <svg class="home-quick__icon" viewBox="0 0 24 24" aria-hidden="true">
          {atalho.icone === 'users' && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></>}
          {atalho.icone === 'document' && <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h8M8 9h2" /></>}
          {atalho.icone === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /></>}
          {atalho.icone === 'video' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m10 9 5 3-5 3z" /></>}
          {atalho.icone === 'message' && <><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4zM8 10h8M8 14h5" /></>}
        </svg>
        <div class="home-quick__copy">
          <h3>{atalho.titulo}</h3>
          <p>{atalho.descricao}</p>
        </div>
        <svg class="home-quick__arrow" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m10 8 4 4-4 4" /></svg>
      </a>
    ))}
  </div>
</section>

<style>

  .home-panel { margin-top: 24px; padding: 24px; border: 1px solid var(--color-border-neutral); border-radius: var(--radius-xl); background: linear-gradient(145deg, #f9fafc, #eef1f5); box-shadow: var(--shadow-surface); scroll-margin-top: 24px; }
  .home-panel > h2 { margin: 0 0 16px; color: var(--color-primary); font-size: 17px; line-height: 1.25; }
  .home-quick__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .home-quick__card { display: grid; grid-template-columns: 30px minmax(0, 1fr); grid-template-rows: 1fr auto; gap: 12px; min-width: 0; min-height: 168px; padding: 17px; border: 1px solid #dce1e9; border-radius: var(--radius-card); background: var(--color-surface); color: inherit; text-decoration: none; box-shadow: var(--shadow-surface-light); transition: border-color 160ms ease, box-shadow 160ms ease; }
  .home-quick__icon { width: 30px; height: 30px; fill: none; stroke: var(--color-primary); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .home-quick__copy { min-width: 0; }
  .home-quick__copy h3 { margin: 0; color: var(--color-heading); font-size: 14px; line-height: 1.35; }
  .home-quick__copy p { margin: 9px 0 0; color: var(--color-text-secondary); font-size: 12px; line-height: 1.5; }
  .home-quick__arrow { grid-column: 2; justify-self: end; width: 22px; height: 22px; fill: none; stroke: var(--color-primary); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .home-quick__card:hover { border-color: var(--color-primary); box-shadow: var(--shadow-surface); }

  .home-quick__card:focus-visible { outline: 3px solid var(--color-primary-bright); outline-offset: 3px; }

  @media (min-width: 768px) and (max-width: 1399px) {
    .home-panel { margin-top: 20px; padding: 22px; }
    .home-quick__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .home-quick__card { min-height: 152px; }
  }

  @media (max-width: 767px) {
    .home-panel { margin-top: 16px; padding: 18px; border-radius: var(--radius-lg); }
    .home-panel > h2 { margin-bottom: 14px; font-size: 17px; }
    .home-quick__grid { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .home-quick__card { min-height: 0; grid-template-columns: 32px minmax(0, 1fr) 20px; grid-template-rows: auto; align-items: center; padding: 16px; }
    .home-quick__copy h3 { font-size: 15px; }
    .home-quick__copy p { margin-top: 6px; font-size: 13px; }
    .home-quick__arrow { grid-column: 3; width: 20px; height: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-quick__card { transition: none; }
  }
</style>
