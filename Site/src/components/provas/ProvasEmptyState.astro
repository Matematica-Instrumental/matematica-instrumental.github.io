---
interface Props {
  tipo: 'vazio' | 'sem-resultados';
  hidden?: boolean;
}

const { tipo, hidden = false } = Astro.props;
const semResultados = tipo === 'sem-resultados';
const mensagem = semResultados
  ? 'Nenhuma prova ou resolução corresponde aos filtros selecionados.'
  : 'Nenhuma prova ou resolução disponível no momento.';
---

<section
  class="proofs-empty"
  data-no-results-state={semResultados ? '' : undefined}
  data-empty-state={!semResultados ? '' : undefined}
  role="status"
  aria-live={semResultados ? 'polite' : undefined}
  aria-atomic={semResultados ? 'true' : undefined}
  hidden={hidden}
>
  {
    semResultados ? (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 4h14v16H5z"></path>
        <path d="M8 8h8M8 12h8M8 16h5"></path>
      </svg>
    )
  }
  <h2>{mensagem}</h2>
  {
    semResultados && (
      <button type="button" data-clear-filters>Limpar filtros</button>
    )
  }
</section>

<style>
  .proofs-empty {
    margin-top: 24px;
    padding: 34px 28px;
    border: 1px solid var(--color-border-neutral);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface-light);
    text-align: center;
  }

  .proofs-empty svg {
    width: 30px;
    height: 30px;
    fill: none;
    stroke: var(--color-primary-bright);
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .proofs-empty h2 {
    margin: 13px auto 0;
    max-width: 680px;
    color: var(--color-heading);
    font-size: 18px;
    line-height: 1.4;
  }

  .proofs-empty button {
    margin-top: 15px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 850;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .proofs-empty button:focus-visible {
    outline: 3px solid rgba(53, 87, 242, 0.28);
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    .proofs-empty {
      margin-top: 18px;
      padding: 28px 18px;
      border-radius: var(--radius-lg);
    }

    .proofs-empty h2 {
      font-size: 16px;
    }
  }
</style>
