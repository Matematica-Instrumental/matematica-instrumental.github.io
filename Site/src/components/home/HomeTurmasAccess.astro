---
import type { AcessoSegmentoTurmasHome } from '../../utils/turmaContent';

interface Props {
  grupos: AcessoSegmentoTurmasHome[];
}

const { grupos } = Astro.props;
---

{grupos.length > 0 && (
  <section class="home-panel home-classes" aria-labelledby="classes-title">
    <h2 id="classes-title">Acesso às turmas</h2>
    <div class:list={['home-classes__grid', { 'home-classes__grid--single': grupos.length === 1 }]}>
      {grupos.map((grupo) => (
        <section class:list={['home-segment', { 'home-segment--medio': grupo.segmento === 'Ensino Médio' }]} aria-labelledby={`home-segment-${grupo.segmentoSlug}`}>
          <h3 id={`home-segment-${grupo.segmentoSlug}`}>{grupo.segmento}</h3>
          <div class="home-segment__years">
            {grupo.anos.map((ano) => (
              <a href={ano.href}>
                <span>{ano.anoSerie}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m10 8 4 4-4 4" /></svg>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
)}

<style>

  .home-panel { margin-top: 24px; padding: 24px; border: 1px solid var(--color-border-neutral); border-radius: var(--radius-xl); background: linear-gradient(145deg, #f9fafc, #eef1f5); box-shadow: var(--shadow-surface); scroll-margin-top: 24px; }
  .home-panel > h2 { margin: 0 0 16px; color: var(--color-primary); font-size: 17px; line-height: 1.25; }

  .home-classes__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .home-classes__grid--single { grid-template-columns: minmax(0, 1fr); }
  .home-segment { --segment-accent: var(--color-primary); --segment-soft: rgba(53, 87, 242, .10); min-width: 0; padding: 16px; border: 1px solid #dce1e9; border-top: 4px solid var(--segment-accent); border-radius: var(--radius-card); background: linear-gradient(135deg, var(--segment-soft), #fff); }
  .home-segment--medio { --segment-accent: var(--color-accent-dark); --segment-soft: rgba(242, 195, 53, .14); }
  .home-segment h3 { margin: 0 0 13px; color: var(--color-heading); font-size: 14px; line-height: 1.4; }
  .home-segment__years { display: flex; flex-wrap: wrap; gap: 10px; }
  .home-segment__years a { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex: 1 1 108px; min-width: 0; min-height: 54px; padding: 12px 14px; border: 1px solid #dce1e9; border-radius: var(--radius-small); background: var(--color-surface); color: var(--color-heading); font-size: 17px; font-weight: 800; text-decoration: none; }
  .home-segment__years svg { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .home-segment__years a:hover { border-color: var(--segment-accent); }

  .home-segment__years a:focus-visible { outline: 3px solid var(--color-primary-bright); outline-offset: 3px; }

  @media (min-width: 768px) and (max-width: 1399px) {
    .home-panel { margin-top: 20px; padding: 22px; }
    .home-classes__grid { gap: 16px; }
    .home-segment__years a { flex-basis: 94px; }
  }

  @media (max-width: 767px) {
    .home-panel { margin-top: 16px; padding: 18px; border-radius: var(--radius-lg); }
    .home-panel > h2 { margin-bottom: 14px; font-size: 17px; }
    .home-classes__grid { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .home-segment { padding: 14px; }
    .home-segment__years a { flex-basis: 94px; font-size: 16px; }
  }
</style>
