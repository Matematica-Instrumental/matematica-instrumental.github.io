---
import {
  getTurmaViewHref,
  TURMA_VIEWS,
  type TurmaRouteData,
  type TurmaViewId,
  type TurmaViewLabel,
} from '../../utils/turmaRoutes';

interface Props {
  activeItem?: TurmaViewLabel;
  activeView?: TurmaViewId;
  turma?: TurmaRouteData;
}

const {
  activeItem = 'Início da turma',
  activeView,
  turma,
} = Astro.props;

const resolvedActiveView = activeView
  ?? TURMA_VIEWS.find(({ label }) => label === activeItem)?.id
  ?? 'inicio';

const currentView = TURMA_VIEWS.find(({ id }) => id === resolvedActiveView)
  ?? TURMA_VIEWS[0];

const menuItems = TURMA_VIEWS.map((view) => ({
  ...view,
  href: turma ? getTurmaViewHref(turma, view.id) : undefined,
  isActive: view.id === resolvedActiveView,
}));
---

<nav
  class="turma-navigation"
  aria-label="Menu interno da turma"
  data-turma-navigation
>
  <div class="turma-navigation__surface">
    <div class="turma-navigation__inner">
      {
        menuItems.map((item) => (
          item.href ? (
            <a
              class:list={[
                'turma-navigation__item',
                {
                  'turma-navigation__item--active': item.isActive,
                },
              ]}
              href={item.href}
              aria-current={item.isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          ) : (
            <span
              class:list={[
                'turma-navigation__item',
                {
                  'turma-navigation__item--active': item.isActive,
                },
              ]}
              aria-current={item.isActive ? 'page' : undefined}
            >
              {item.label}
            </span>
          )
        ))
      }
    </div>

    {
      turma ? (
        <>
          <button
            class="turma-navigation__mobile-control"
            type="button"
            aria-label={`Menu da turma. Visão atual: ${currentView.label}`}
            aria-expanded="false"
            aria-controls="turma-navigation-mobile-list"
            data-turma-navigation-toggle
          >
            <span class="turma-navigation__mobile-kicker">
              Menu da turma
            </span>

            <span class="turma-navigation__mobile-current">
              {currentView.label}
            </span>

            <span
              class="turma-navigation__mobile-chevron"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24">
                <path d="m7 10 5 5 5-5" />
              </svg>
            </span>
          </button>

          <div
            class="turma-navigation__mobile-list"
            id="turma-navigation-mobile-list"
            hidden
            data-turma-navigation-list
          >
            {
              menuItems.map((item) => (
                <a
                  class:list={[
                    'turma-navigation__mobile-item',
                    {
                      'turma-navigation__mobile-item--active': item.isActive,
                    },
                  ]}
                  href={item.href}
                  aria-current={item.isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </>
      ) : (
        <div class="turma-navigation__mobile-control" aria-hidden="true">
          <span class="turma-navigation__mobile-kicker">
            Menu da turma
          </span>

          <span class="turma-navigation__mobile-current">
            {currentView.label}
          </span>

          <span class="turma-navigation__mobile-chevron">
            <svg viewBox="0 0 24 24">
              <path d="m7 10 5 5 5-5" />
            </svg>
          </span>
        </div>
      )
    }
  </div>
</nav>

<style>
  .turma-navigation {
    --sticky-bridge-height: var(--section-gap-desktop);

    position: sticky;
    top: 68px;
    z-index: 90;
    height: 72px;
    margin-top: 24px;
    isolation: isolate;
  }

  .turma-navigation::before {
    content: '';
    position: absolute;
    top: calc(-1 * var(--sticky-bridge-height));
    right: 0;
    bottom: 0;
    left: 0;
    z-index: -1;
    background: var(--color-page-background);
    box-shadow: 0 0 0 100vmax var(--color-page-background);
    clip-path: inset(0 -100vmax);
    pointer-events: none;
  }

  .turma-navigation__surface {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1.5px solid rgba(53, 87, 242, 0.28);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-surface-light);
  }

  .turma-navigation__inner {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns:
      1.15fr
      0.95fr
      1.35fr
      1.05fr
      0.85fr
      0.85fr
      0.70fr
      0.62fr;
    align-items: stretch;
  }

  .turma-navigation__item {
    position: relative;
    min-width: 0;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid rgba(53, 87, 242, 0.10);
    color: #384255;
    font-size: 13px;
    line-height: 1.15;
    font-weight: 750;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .turma-navigation__item:last-child {
    border-right: 0;
  }

  .turma-navigation__item--active {
    color: var(--color-primary);
    background:
      linear-gradient(
        180deg,
        rgba(53, 87, 242, 0.11),
        rgba(53, 87, 242, 0.045)
      );
  }

  .turma-navigation__item--active::after {
    content: '';
    position: absolute;
    right: 10%;
    bottom: 0;
    left: 10%;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .turma-navigation__item--active::before {
    content: '';
    width: 7px;
    height: 7px;
    margin-right: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--color-primary-bright);
  }

  .turma-navigation__mobile-control {
    display: none;
  }

  .turma-navigation__mobile-list {
    display: none;
  }

  @media (min-width: 768px) and (max-width: 1399px) {
    .turma-navigation {
      --sticky-bridge-height: var(--section-gap-tablet);

      top: 112px;
      height: 116px;
      margin-top: 20px;
    }

    .turma-navigation__inner {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(2, 58px);
    }

    .turma-navigation__item {
      padding: 0 8px;
      border-right: 1px solid rgba(53, 87, 242, 0.10);
      border-bottom: 1px solid rgba(53, 87, 242, 0.10);
      font-size: 12px;
    }

    .turma-navigation__item:nth-child(4n) {
      border-right: 0;
    }

    .turma-navigation__item:nth-child(n + 5) {
      border-bottom: 0;
    }

    .turma-navigation__item--active::after {
      height: 3px;
    }
  }

  @media (max-width: 767px) {
    .turma-navigation {
      --sticky-bridge-height: var(--section-gap-mobile);

      top: 58px;
      height: 58px;
      margin-top: 16px;
    }

    .turma-navigation--open {
      height: auto;
    }

    .turma-navigation__surface {
      height: auto;
      border-radius: var(--radius-card);
    }

    .turma-navigation__inner {
      display: none;
    }

    .turma-navigation__mobile-control {
      width: 100%;
      height: 58px;
      padding: 7px 14px;
      display: grid;
      grid-template-columns: 1fr auto 20px;
      grid-template-rows: 20px 24px;
      align-content: center;
      column-gap: 8px;
      border: 0;
      background: var(--color-surface);
      color: inherit;
      font: inherit;
      text-align: left;
      appearance: none;
    }

    button.turma-navigation__mobile-control {
      cursor: pointer;
    }

    .turma-navigation__mobile-kicker {
      grid-column: 1 / -1;
      color: #727b89;
      font-size: 9px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .turma-navigation__mobile-current {
      grid-column: 1;
      grid-row: 2;
      color: var(--color-primary);
      font-size: 13px;
      font-weight: 850;
    }

    .turma-navigation__mobile-chevron {
      grid-column: 3;
      grid-row: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .turma-navigation__mobile-chevron svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: var(--color-primary);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .turma-navigation__mobile-control[aria-expanded='true']
      .turma-navigation__mobile-chevron svg {
      transform: rotate(180deg);
    }

    .turma-navigation__mobile-list {
      display: block;
      border-top: 1px solid rgba(53, 87, 242, 0.16);
      background: var(--color-surface);
    }

    .turma-navigation__mobile-list[hidden] {
      display: none;
    }

    .turma-navigation__mobile-item {
      min-height: 48px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      border-top: 1px solid rgba(53, 87, 242, 0.10);
      color: #384255;
      font-size: 13px;
      line-height: 1.25;
      font-weight: 750;
      text-align: left;
      text-decoration: none;
    }

    .turma-navigation__mobile-item:first-child {
      border-top: 0;
    }

    .turma-navigation__mobile-item--active {
      color: var(--color-primary);
      background:
        linear-gradient(
          180deg,
          rgba(53, 87, 242, 0.11),
          rgba(53, 87, 242, 0.045)
        );
      font-weight: 850;
    }
  }
</style>

<script>
  const navigations = document.querySelectorAll<HTMLElement>(
    '[data-turma-navigation]',
  );

  navigations.forEach((navigation) => {
    const toggle = navigation.querySelector<HTMLButtonElement>(
      '[data-turma-navigation-toggle]',
    );
    const list = navigation.querySelector<HTMLElement>(
      '[data-turma-navigation-list]',
    );

    if (!toggle || !list) {
      return;
    }

    const setOpen = (isOpen: boolean) => {
      toggle.setAttribute('aria-expanded', String(isOpen));
      list.hidden = !isOpen;
      navigation.classList.toggle('turma-navigation--open', isOpen);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    navigation.addEventListener('keydown', (event) => {
      if (
        event.key !== 'Escape'
        || toggle.getAttribute('aria-expanded') !== 'true'
      ) {
        return;
      }

      setOpen(false);
      toggle.focus();
    });
  });
</script>
