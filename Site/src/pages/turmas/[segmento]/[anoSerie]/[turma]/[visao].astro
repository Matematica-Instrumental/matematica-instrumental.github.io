---
import { getCollection } from 'astro:content';
import TurmaVisaoPagina from '../../../../../components/turma/TurmaVisaoPagina.astro';
import { assertCurrentContentIntegrity } from '../../../../../utils/contentIntegrityBuild';
import {
  getTurmaRouteParams,
  TURMA_INTERNAL_VIEWS,
  turmaEhCurso,
} from '../../../../../utils/turmaRoutes';

export async function getStaticPaths() {
  await assertCurrentContentIntegrity();
  const turmas = await getCollection('turmas', ({ data }) => !turmaEhCurso(data));

  return turmas.flatMap((entry) => {
    const turmaParams = getTurmaRouteParams(entry.data);

    return TURMA_INTERNAL_VIEWS.map((view) => ({
      params: {
        ...turmaParams,
        visao: view.slug,
      },
      props: {
        turma: entry.data,
        activeView: view.id,
      },
    }));
  });
}

const { turma, activeView } = Astro.props;
---

<TurmaVisaoPagina turma={turma} activeView={activeView} />
