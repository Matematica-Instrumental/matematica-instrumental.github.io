---
import symbol from '../../assets/brand/simbolo-oficial-colorido.png';
import signature from '../../assets/brand/assinatura-colorida.png';
import { applyAstroBaseUrl } from '../../utils/turmaRoutes';

const inicioHref = applyAstroBaseUrl('/');
const turmasHref = applyAstroBaseUrl('/turmas/');
const provasHref = applyAstroBaseUrl('/provas-e-resolucoes/');
const oportunidadesHref = applyAstroBaseUrl('/oportunidades-e-datas/');
const matematicaAlemHref = applyAstroBaseUrl('/matematica-alem-da-sala/');
const contatoHref = applyAstroBaseUrl('/falar-com-o-professor/');
---

<footer class="site-footer" aria-label="Rodapé institucional">
  <div class="site-footer__inner">
    <div class="site-footer__main">
      <div class="site-footer__brand" aria-label="Matemática Instrumental">
        <img
          class="site-footer__brand-symbol"
          src={symbol.src}
          alt=""
          width={symbol.width}
          height={symbol.height}
        />

        <img
          class="site-footer__brand-signature"
          src={signature.src}
          alt="Matemática Instrumental"
          width={signature.width}
          height={signature.height}
        />
      </div>

      <div class="site-footer__column">
        <h2>Navegação</h2>

        <div class="site-footer__links">
          <a href={inicioHref}>Início</a>
          <a href={turmasHref}>Turmas</a>
          <a href={provasHref}>Provas e Resoluções</a>
        </div>
      </div>

      <div class="site-footer__column">
        <h2>Informações</h2>

        <div class="site-footer__links">
          <a href={oportunidadesHref}>Oportunidades e Datas</a>
          <a href={matematicaAlemHref}>Matemática além da sala</a>
          <a href={contatoHref}>Falar com o Professor</a>
        </div>
      </div>

      <div class="site-footer__column">
        <h2>Siga-nos</h2>

        <div class="site-footer__social" aria-label="Redes sociais">
          <span
            class="site-footer__social-icon site-footer__social-icon--youtube"
            role="img"
            aria-label="YouTube"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="6" width="18" height="12" rx="4" />
              <path class="fill" d="M10 9.2 15.5 12 10 14.8z" />
            </svg>
          </span>

          <span
            class="site-footer__social-icon"
            role="img"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16" rx="5" />
              <circle cx="12" cy="12" r="3.4" />
              <circle cx="17.5" cy="6.7" r=".8" />
            </svg>
          </span>

          <span
            class="site-footer__social-icon"
            role="img"
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.5 8H17V4.5h-2.5c-3 0-4.5 1.7-4.5 4.6V11H7v3.5h3V21h4v-6.5h3l.5-3.5H14V9.2c0-.8.2-1.2.5-1.2Z" />
            </svg>
          </span>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        Matemática Instrumental — Professor Adriano Lima Teixeira. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    min-height: 220px;
    margin-top: 24px;
    border-top: 1px solid #c8ced6;
    background: linear-gradient(180deg, #e5e8ec 0%, #dfe3e8 100%);
    color: #445063;
  }

  .site-footer__inner {
    width: var(--content-width-desktop);
    margin: 0 auto;
    padding: 28px 0 18px;
  }

  .site-footer__main {
    min-height: 132px;
    display: grid;
    grid-template-columns: 1.45fr 0.85fr 1fr 0.85fr;
    gap: 48px;
    align-items: start;
  }

  .site-footer__brand {
    padding-top: 2px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .site-footer__brand-symbol {
    width: 64px;
    height: auto;
    flex: none;
  }

  .site-footer__brand-signature {
    width: 225px;
    height: auto;
  }

  .site-footer__column h2 {
    margin: 0 0 11px;
    color: #26334a;
    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .site-footer__links a {
    color: #556174;
    font-size: 12px;
    line-height: 1.25;
    font-weight: 650;
    text-decoration: none;
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .site-footer__social-icon {
    width: 34px;
    height: 34px;
    border: 1.5px solid rgba(3, 32, 166, 0.24);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.58);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .site-footer__social-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .site-footer__social-icon--youtube svg .fill {
    fill: currentColor;
    stroke: none;
  }

  .site-footer__bottom {
    min-height: 40px;
    padding-top: 13px;
    border-top: 1px solid rgba(80, 92, 110, 0.18);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .site-footer__bottom p {
    margin: 0;
    color: #6a7382;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 600;
    text-align: center;
  }

  @media (min-width: 768px) and (max-width: 1399px) {
    .site-footer {
      min-height: 300px;
      margin-top: 20px;
    }

    .site-footer__inner {
      width: var(--content-width-tablet);
      padding: 26px 0 18px;
    }

    .site-footer__main {
      min-height: 208px;
      grid-template-columns: 1.45fr 1fr;
      grid-template-rows: auto auto;
      gap: 28px 44px;
    }

    .site-footer__brand-signature {
      width: 200px;
    }

    .site-footer__bottom {
      margin-top: 16px;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      min-height: 0;
      margin-top: 16px;
    }

    .site-footer__inner {
      width: var(--content-width-mobile);
      padding: 24px 0 16px;
    }

    .site-footer__main {
      min-height: 0;
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 22px;
    }

    .site-footer__brand {
      justify-content: flex-start;
    }

    .site-footer__brand-symbol {
      width: 52px;
    }

    .site-footer__brand-signature {
      width: 176px;
    }

    .site-footer__column h2 {
      font-size: 12px;
    }

    .site-footer__links a {
      font-size: 11px;
    }

    .site-footer__bottom {
      margin-top: 20px;
      padding-top: 12px;
    }

    .site-footer__bottom p {
      font-size: 10px;
    }
  }
</style>
