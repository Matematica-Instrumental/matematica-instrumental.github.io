---
interface LinkSummaryItem {
  finalidade: string;
  tipo: string;
  titulo: string;
  caminho?: string;
  nota?: string;
  acessarHref?: string;
}

interface Props {
  itens: LinkSummaryItem[];
  verTodosHref?: string;
}

const {
  itens,
  verTodosHref,
} = Astro.props;
---

<div class="links-summary">
  {
    itens.map((item) => (
      <article class="links-summary__item">
        <div class="links-summary__main">
          <div class="links-summary__meta">
            <span class="links-summary__purpose">
              {item.finalidade}
            </span>

            <span class="links-summary__type">
              {item.tipo}
            </span>
          </div>

          <p class="links-summary__name">
            {item.titulo}
          </p>

          {
            item.caminho && (
              <p class="links-summary__path">
                {item.caminho}
              </p>
            )
          }

          {
            item.nota && (
              <p class="links-summary__note">
                {item.nota}
              </p>
            )
          }
        </div>

        {
          item.acessarHref ? (
            <a
              class="links-summary__open"
              href={item.acessarHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              Acessar

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 3h7v7" />
                <path d="M10 14 21 3" />
                <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" />
              </svg>
            </a>
          ) : (
            <span class="links-summary__open">
              Acessar

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 3h7v7" />
                <path d="M10 14 21 3" />
                <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" />
              </svg>
            </span>
          )
        }
      </article>
    ))
  }

  {
    verTodosHref ? (
      <a
        class="links-summary__link"
        href={verTodosHref}
      >
        Ver todos os links →
      </a>
    ) : (
      <span class="links-summary__link">
        Ver todos os links →
      </span>
    )
  }
</div>

<style>
  .links-summary {
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .links-summary__item {
    min-height: 58px;
    padding: 7px 10px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: center;
    border: 1px solid rgba(166, 129, 20, 0.15);
    border-radius: var(--radius-small);
    background: rgba(255, 255, 255, 0.76);
  }

  .links-summary__main {
    min-width: 0;
  }

  .links-summary__meta {
    min-width: 0;
    margin-bottom: 3px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .links-summary__purpose {
    padding: 3px 7px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    background: rgba(255, 212, 82, 0.22);
    color: #765a00;
    font-size: 9px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .links-summary__type {
    color: #7a8494;
    font-size: 10px;
    font-weight: 750;
    white-space: nowrap;
  }

  .links-summary__name {
    margin: 0;
    overflow: hidden;
    color: #2f3b50;
    font-size: 12px;
    line-height: 1.22;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .links-summary__path,
  .links-summary__note {
    margin: 2px 0 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 10px;
    line-height: 1.18;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .links-summary__open {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-accent-dark);
    font-size: 10px;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
  }

  .links-summary__open svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .links-summary__link {
    margin-top: 3px;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    color: var(--color-accent-dark);
    font-size: 11px;
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .links-summary__item {
      grid-template-columns: 1fr auto;
      gap: 8px;
    }

    .links-summary__name,
    .links-summary__path,
    .links-summary__note {
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
    }
  }
</style>
