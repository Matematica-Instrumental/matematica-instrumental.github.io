---
interface MaterialSummaryItem {
  tipo?: string;
  publicacao: string;
  titulo: string;
  caminho: string;
  abrirHref?: string;
}

interface Props {
  itens: MaterialSummaryItem[];
  verTodosHref?: string;
}

const {
  itens,
  verTodosHref,
} = Astro.props;
---

<div class="materials-summary">
  {
    itens.map((item) => (
      <article class="materials-summary__item">
        <div class="materials-summary__main">
          <div class="materials-summary__meta">
            {
              item.tipo && (
                <span class="materials-summary__type">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <path d="M14 2v6h6" />
                  </svg>

                  {item.tipo}
                </span>
              )
            }

            <span class="materials-summary__publication">
              {item.publicacao}
            </span>
          </div>

          <p class="materials-summary__name">
            {item.titulo}
          </p>

          <p class="materials-summary__path">
            {item.caminho}
          </p>
        </div>

        {
          item.abrirHref ? (
            <a
              class="materials-summary__open"
              href={item.abrirHref}
            >
              Abrir ↗
            </a>
          ) : (
            <span class="materials-summary__open">
              Abrir ↗
            </span>
          )
        }
      </article>
    ))
  }

  {
    verTodosHref ? (
      <a
        class="materials-summary__link"
        href={verTodosHref}
      >
        Ver todos os materiais →
      </a>
    ) : (
      <span class="materials-summary__link">
        Ver todos os materiais →
      </span>
    )
  }
</div>

<style>
  .materials-summary {
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .materials-summary__item {
    min-height: 58px;
    padding: 7px 10px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: center;
    border: 1px solid rgba(166, 129, 20, 0.16);
    border-radius: var(--radius-small);
    background: rgba(255, 255, 255, 0.76);
  }

  .materials-summary__main {
    min-width: 0;
  }

  .materials-summary__meta {
    margin-bottom: 3px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .materials-summary__type {
    padding: 3px 7px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: var(--radius-pill);
    background: rgba(242, 195, 53, 0.18);
    color: #765a00;
    font-size: 9px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .materials-summary__type svg {
    width: 10px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .materials-summary__publication {
    color: #7a8494;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }

  .materials-summary__name {
    margin: 0;
    overflow: hidden;
    color: #2f3b50;
    font-size: 12px;
    line-height: 1.25;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .materials-summary__path {
    margin: 2px 0 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 10px;
    line-height: 1.2;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .materials-summary__open {
    color: var(--color-accent-dark);
    font-size: 10px;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
  }

  .materials-summary__link {
    margin-top: 3px;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    color: var(--color-accent-dark);
    font-size: 11px;
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .materials-summary__item {
      grid-template-columns: 1fr auto;
      gap: 8px;
    }

    .materials-summary__name,
    .materials-summary__path {
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
    }
  }
</style>
