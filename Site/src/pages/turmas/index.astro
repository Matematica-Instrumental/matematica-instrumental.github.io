---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TurmasView from '../../components/turmas/TurmasView.astro';
import {
  getCursosTurmasGlobais,
  getSegmentosTurmasGlobais,
} from '../../utils/turmaContent';

const [segmentos, cursos] = await Promise.all([
  getSegmentosTurmasGlobais(),
  getCursosTurmasGlobais(),
]);
---

<BaseLayout title="Turmas | Matemática Instrumental">
  <TurmasView segmentos={segmentos} cursos={cursos} />
</BaseLayout>
