---
import { applyAstroBaseUrl } from '../../utils/turmaRoutes';

interface Props {
  persistent?: boolean;
}

const {
  persistent = false,
} = Astro.props;

const currentPath = Astro.url.pathname;

const menuItems = [
  {
    label: 'Início',
    pathname: '/',
    icon: 'home',
  },
  {
    label: 'Turmas',
    pathname: '/turmas/',
    icon: 'users',
  },
  {
    label: 'Provas e Resoluções',
    pathname: '/provas-e-resolucoes/',
    icon: 'document',
  },
  {
    label: 'Oportunidades e Datas',
    pathname: '/oportunidades-e-datas/',
    icon: 'calendar',
  },
  {
    label: 'Matemática além da sala',
    pathname: '/matematica-alem-da-sala/',
    icon: 'video',
  },
  {
    label: 'Falar com o Professor',
    pathname: '/falar-com-o-professor/',
    icon: 'message',
    contact: true,
  },
].map((item) => ({
  ...item,
  href: applyAstroBaseUrl(item.pathname),
}));

const isActive = (pathname: string, href: string) => {
  if (pathname === '/') {
    return currentPath === href;
  }

  return currentPath.startsWith(href);
};

const currentMenuLabel =
  menuItems.find((item) => isActive(item.pathname, item.href))?.label
  ?? 'Início';
---

<nav
  class:list={[
    'main-navigation',
    { 'main-navigation--persistent': persistent },
  ]}
  aria-label="Menu principal do portal"
  data-main-navigation
>
  <button
    class="main-navigation__mobile-control"
    type="button"
    aria-label={`Menu principal. Página atual: ${currentMenuLabel}`}
    aria-expanded="false"
    aria-controls="main-navigation-mobile-list"
    data-main-navigation-toggle
  >
    <span class="main-navigation__mobile-icon">
      <svg viewBox="0 0 24 24">
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </span>

    <span class="main-navigation__mobile-label">
      Menu principal
    </span>

    <span class="main-navigation__mobile-current">
      {currentMenuLabel}
    </span>

    <span class="main-navigation__mobile-chevron">
      <svg viewBox="0 0 24 24">
        <path d="m7 10 5 5 5-5" />
      </svg>
    </span>
  </button>

  <div
    class="main-navigation__inner"
    id="main-navigation-mobile-list"
    data-main-navigation-list
  >
    {
      menuItems.map((item) => (
        <a
          class:list={[
            'main-navigation__item',
            {
              'main-navigation__item--active': isActive(item.pathname, item.href),
              'main-navigation__item--contact': item.contact,
            },
          ]}
          href={item.href}
          aria-current={isActive(item.pathname, item.href) ? 'page' : undefined}
        >
          {item.icon === 'home' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 11.5 12 4l9 7.5" />
              <path d="M5.5 10.5V20h13v-9.5" />
              <path d="M9.5 20v-6h5v6" />
            </svg>
          )}

          {item.icon === 'users' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          )}

          {item.icon === 'document' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <path d="M14 2v6h6" />
              <path d="M8 13h8" />
              <path d="M8 17h8" />
              <path d="M8 9h2" />
            </svg>
          )}

          {item.icon === 'calendar' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="2" />
              <path d="M16 3v4" />
              <path d="M8 3v4" />
              <path d="M3 11h18" />
            </svg>
          )}

          {item.icon === 'video' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m10 9 5 3-5 3z" />
            </svg>
          )}

          {item.icon === 'message' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
              <path d="M8 10h8" />
              <path d="M8 14h5" />
            </svg>
          )}

          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>

<style>
  .main-navigation {
    position: relative;
    height: 68px;
    background: var(--color-primary);
    border-bottom: 3px solid var(--color-accent);
    color: #fff;
  }

  .main-navigation--persistent {
    position: sticky;
    top: 0;
    z-index: 100;
    isolation: isolate;
  }

  .main-navigation__inner {
    width: var(--global-menu-width-desktop);
    height: 68px;
    margin: 0 auto;
    display: flex;
    flex-flow: row nowrap;
    align-items: stretch;
    justify-content: space-between;
    gap: 0;
  }

  .main-navigation__item {
    position: relative;
    min-width: 0;
    padding: 0 12px;
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .main-navigation__item:nth-child(1) {
    flex: 0.75 1 0;
  }

  .main-navigation__item:nth-child(2) {
    flex: 0.80 1 0;
  }

  .main-navigation__item:nth-child(3) {
    flex: 1.30 1 0;
  }

  .main-navigation__item:nth-child(4) {
    flex: 1.45 1 0;
  }

  .main-navigation__item:nth-child(5) {
    flex: 1.50 1 0;
  }

  .main-navigation__item:nth-child(6) {
    flex: 1.25 1 0;
  }

  .main-navigation__item span {
    display: block;
    white-space: nowrap;
  }

  .main-navigation__item svg {
    width: 23px;
    height: 23px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .main-navigation__item--active {
    background: rgba(53, 87, 242, 0.48);
  }

  .main-navigation__item--active::after {
    content: '';
    position: absolute;
    right: 14px;
    bottom: 0;
    left: 14px;
    height: 4px;
    border-radius: 4px 4px 0 0;
    background: var(--color-accent-light);
  }

  .main-navigation__item--contact {
    color: var(--color-accent-light);
  }

  .main-navigation__mobile-control {
    display: none;
  }

  @media (min-width: 768px) and (max-width: 1399px) {
    .main-navigation {
      height: 112px;
    }

    .main-navigation__inner {
      width: var(--content-width-tablet);
      height: 112px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 56px);
    }

    .main-navigation__item {
      padding: 0 8px;
      border-right: 1px solid rgba(255, 255, 255, 0.10);
      border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      font-size: 12px;
    }

    .main-navigation__item:nth-child(n) {
      flex: none;
    }

    .main-navigation__item:nth-child(3n) {
      border-right: 0;
    }

    .main-navigation__item:nth-child(n + 4) {
      border-bottom: 0;
    }

    .main-navigation__item svg {
      width: 20px;
      height: 20px;
    }

    .main-navigation__item--active::after {
      right: 24px;
      left: 24px;
      height: 3px;
    }
  }

  @media (max-width: 767px) {
    .main-navigation {
      height: 58px;
    }

    .main-navigation__inner {
      display: none;
    }

    .main-navigation--open .main-navigation__inner {
      position: absolute;
      top: 58px;
      left: 50%;
      z-index: 110;
      width: var(--content-width-mobile);
      height: auto;
      margin: 0;
      display: grid;
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: 0;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-top: 0;
      border-radius: 0 0 var(--radius-card) var(--radius-card);
      background: var(--color-primary);
      box-shadow: 0 10px 22px rgba(3, 32, 166, 0.22);
      transform: translateX(-50%);
    }

    .main-navigation__item,
    .main-navigation__item:nth-child(n) {
      min-height: 48px;
      padding: 10px 14px;
      justify-content: flex-start;
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 12px;
      text-align: left;
      white-space: normal;
    }

    .main-navigation__item:last-child {
      border-bottom: 0;
    }

    .main-navigation__item span {
      white-space: normal;
    }

    .main-navigation__item svg {
      width: 20px;
      height: 20px;
    }

    .main-navigation__item--active::after {
      top: 9px;
      right: auto;
      bottom: 9px;
      left: 0;
      width: 4px;
      height: auto;
      border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    }

    .main-navigation__mobile-control {
      width: var(--content-width-mobile);
      height: 58px;
      padding: 0;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 32px 1fr auto 22px;
      align-items: center;
      gap: 8px;
      border: 0;
      background: transparent;
      color: #fff;
      font: inherit;
      text-align: left;
      cursor: pointer;
      appearance: none;
    }

    .main-navigation__mobile-icon,
    .main-navigation__mobile-chevron {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .main-navigation__mobile-icon svg {
      width: 23px;
      height: 23px;
      fill: none;
      stroke: var(--color-accent-light);
      stroke-width: 2;
      stroke-linecap: round;
    }

    .main-navigation__mobile-label {
      font-size: 13px;
      font-weight: 850;
    }

    .main-navigation__mobile-current {
      padding: 5px 8px;
      border: 1px solid rgba(255, 212, 82, 0.32);
      border-radius: var(--radius-pill);
      color: var(--color-accent-light);
      font-size: 11px;
      font-weight: 800;
    }

    .main-navigation__mobile-chevron svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: #fff;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .main-navigation__mobile-control[aria-expanded='true']
      .main-navigation__mobile-chevron svg {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  const navigations = document.querySelectorAll<HTMLElement>(
    '[data-main-navigation]',
  );

  navigations.forEach((navigation) => {
    const toggle = navigation.querySelector<HTMLButtonElement>(
      '[data-main-navigation-toggle]',
    );

    if (!toggle) {
      return;
    }

    const setOpen = (isOpen: boolean) => {
      toggle.setAttribute('aria-expanded', String(isOpen));
      navigation.classList.toggle('main-navigation--open', isOpen);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    navigation.addEventListener('keydown', (event) => {
      if (
        event.key !== 'Escape'
        || toggle.getAttribute('aria-expanded') !== 'true'
      ) {
        return;
      }

      setOpen(false);
      toggle.focus();
    });
  });
</script>
